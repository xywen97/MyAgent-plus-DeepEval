# 复制为 .env 后填写。兼容任意 OpenAI Chat Completions 协议的服务。
MYAGENT_API_KEY=sk-xxx
# 留空则使用 OpenAI 官方地址；示例：https://api.deepseek.com/v1
MYAGENT_BASE_URL=
MYAGENT_MODEL=gpt-4o

# 可选项
# MYAGENT_WORKSPACE=/path/to/your/project
# MYAGENT_MAX_STEPS=50
# MYAGENT_COMMAND_TIMEOUT=120
# MYAGENT_AUTO_APPROVE=false
# MYAGENT_LANGUAGE=简体中文 (Simplified Chinese)
